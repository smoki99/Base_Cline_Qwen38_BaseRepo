# API
PORT=4001
# Bind address (default 127.0.0.1 = loopback-only; set 0.0.0.0 for LAN/Docker)
HOST=127.0.0.1
# CORS – comma-separated allowed origins for the API (prod), e.g. https://app.example.com
# Empty (dev) = allow all origins. Empty + NODE_ENV=production = fail-closed (403).
CORS_ORIGIN=
# Web (VITE_-Präfix = wird ins Bundle kopiert)
# Optional override – by default the web app uses relative /api/* paths
# (dev: Vite proxy, prod: reverse proxy). Only set if the API lives elsewhere.
VITE_API_URL=http://localhost:4001